{
  "name": "agency-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "design:map": "npm run tokens && node scripts/map-design-tools.mjs",
    "build": "npm run tokens && npm run build --workspace @agency/react",
    "storybook": "npm run tokens && storybook dev -p 6006 --no-open",
    "build:storybook": "npm run tokens && storybook build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build:storybook",
    "mcp": "node packages/mcp/src/server.mjs",
    "test:browser": "playwright test",
    "test:distribution": "npm run build && node scripts/test-distribution.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
